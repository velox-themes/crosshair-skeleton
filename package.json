{
  "name": "crosshair-skeleton",
  "version": "1.0.0",
  "description": "A loading skeleton that locks onto any element, maps a grid over it, traces what is inside, then reveals the real content. No dependencies, any framework, light and dark.",
  "type": "module",
  "main": "./crosshair-skeleton.js",
  "module": "./crosshair-skeleton.js",
  "types": "./crosshair-skeleton.d.ts",
  "exports": {
    ".": {
      "types": "./crosshair-skeleton.d.ts",
      "default": "./crosshair-skeleton.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./svelte": {
      "types": "./svelte.d.ts",
      "default": "./svelte.js"
    }
  },
  "files": [
    "crosshair-skeleton.js",
    "crosshair-skeleton.d.ts",
    "react.js",
    "react.d.ts",
    "vue.js",
    "vue.d.ts",
    "svelte.js",
    "svelte.d.ts",
    "SKILL.md",
    "AGENT-GUIDE.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=16.8",
    "svelte": ">=3",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "keywords": [
    "skeleton",
    "skeleton-loader",
    "loading",
    "loading-state",
    "placeholder",
    "animation",
    "crosshair",
    "wireframe",
    "react",
    "vue",
    "svelte",
    "agent-skill"
  ],
  "license": "MIT",
  "author": "Velox Themes (https://library.veloxthemes.com)",
  "homepage": "https://github.com/velox-themes/crosshair-skeleton#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velox-themes/crosshair-skeleton.git"
  },
  "bugs": {
    "url": "https://github.com/velox-themes/crosshair-skeleton/issues"
  }
}
